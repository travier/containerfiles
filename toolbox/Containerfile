FROM registry.fedoraproject.org/fedora-toolbox:45 as builder

RUN <<EORUN
set -euxo pipefail

# Disable weak dependencies (recommends & suggests)
dnf config-manager setopt install_weak_deps=0

# Disable cisco-openh264 repo as we never want to use it
dnf config-manager disable fedora-cisco-openh264

# Setup testing-farm COPR
dnf copr enable -y @testing-farm/stable
dnf config-manager disable copr:copr.fedorainfracloud.org:group_testing-farm:stable

# Setup Terra community repository
dnf -y install --nogpgcheck --repofrompath 'terra,https://repos.fyralabs.com/terra$releasever' terra-release terra-gpg-keys
dnf config-manager disable terra

# Packages to install
packages=(

# Editors
helix
helix-parsers
helix-themes
vim

# Shell and related tools
asciinema
fd-find
fzf
host-spawn
parallel
ripgrep
zoxide
zsh

# Development tools
ShellCheck
black
clang-format
flatpak-builder
g++
gcc
gh
git-absorb
git-clang-format
git-credential-libsecret
git-delta
git-filter-repo
go
intltool
json-glib-devel
just
make
meson
pylint
python3-dateparser
python3-pip
python3-rust2rpm
reuse
ruff
source-foundry-hack-fonts
yamllint

# Fedora packaging tools
copr-cli
createrepo_c
fedora-license-data
fedora-packager
fedora-packager-kerberos
fedora-repoquery
fedora-repos-rawhide
fedora-review
fedpkg
fedpkg-completion
license-validate
licensecheck
rpmautospec
rpmdistro-repoquery
rust2rpm+ingredients
rust2rpm-helper

# Other tools
bind-utils
erofs-utils
inotify-tools
jq
pwgen
restic
socat
sqlite

# CoreOS tools
butane
coreos-installer
ignition-validate

# Website / jekyll tools
ImageMagick
brotli
dejavu-sans-fonts
dejavu-sans-mono-fonts
graphviz
npm
qrencode
ruby
ruby-devel
rubygem-bundler

# Build dependencies for some Rust applications
openssl-devel
perl-File-Compare
perl-FindBin
perl-IPC-Cmd

# virt-install for libvirt
virt-install
)

packages_terra=(
typst
typst-bash-completion
typst-zsh-completion
)

packages_testing_farm=(
# Tools for CI
packit
testing-farm
tmt
)

# Update all packages
dnf -y update

# Install packages
dnf -y install "${packages[@]}"
dnf -y install --enable-repo=terra "${packages_terra[@]}"
dnf -y install --enable-repo=copr:copr.fedorainfracloud.org:group_testing-farm:stable "${packages_testing_farm[@]}"

# Setup symlink for access to system libvirt
ln -snf /run/host/run/libvirt /run/libvirt

# Remove mlocate, not useful inside an ephemeral container
dnf -y remove mlocate
dnf clean all

# Setup host-spawn symlinks
set -euxo pipefail
bins=(
    "btop"
    "buildah"
    "code"
    "codium"
    "firefox"
    "flatpak"
    "htop"
    "podman"
    "rpm-ostree"
    "skopeo"
    "systemctl"
    "xdg-open"
);
for f in "${bins[@]}"; do
    ln -s /usr/bin/host-spawn /usr/local/bin/$f
done

# No need to clear the output as we will never use ZSH as a login shell and
# this clears output when exiting toolboxes.
sed -i '/clear/d' /etc/zlogout
EORUN

# Rechunk
FROM quay.io/coreos/chunkah AS chunkah
RUN --mount=from=builder,src=/,target=/chunkah,ro \
    --mount=type=bind,target=/run/src,rw \
        chunkah build > /run/src/out.ociarchive

# Final image
FROM oci-archive:out.ociarchive
